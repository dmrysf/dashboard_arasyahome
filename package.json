{
  "name": "arasya-dashboard",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-dashboard-htaccess.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:e2e:real": "node e2e/prepare-real-api.mjs && VITE_DASHBOARD_API_BASE_URL=http://127.0.0.1:8788 vite build --mode e2e && playwright test -c playwright.real-api.config.ts",
    "verify": "tsc --noEmit && eslint . && tsx --test tests/*.test.ts tests/*.test.tsx && pnpm build && node scripts/verify-build.mjs && /bin/bash tests/dashboard-deploy.sh"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
